# Telegram Bot Token (от BotFather)
BOT_TOKEN=сюда_вставь_токен_бота

# ID владельца бота (доступ к /stats). Узнай свой ID у @userinfobot
OWNER_ID=0

# Upstash Redis — постоянное хранение статистики (URL + токен из дашборда).
# Если оставить пустым — статистика живёт в памяти и сбрасывается при рестарте.
# REDIS_URL=
# REDIS_TOKEN=

# Стикер для приветствия (file_id, менять вручную)
# STICKER_FILE_ID=

# Максимальный размер видео в МБ (лимит Telegram Bot API — 50)
MAX_VIDEO_MB=45

# Пауза между запросами одного пользователя (в секундах)
DOWNLOAD_COOLDOWN_SEC=10

# Если TikTok блокирует скачивание (ошибка про IP) — укажи браузер,
# из которого возьмём cookies (chrome / edge / firefox). Оставь пустым, если не нужно.
# COOKIES_FROM_BROWSER=chrome

# Или путь к файлу cookies.txt (например, сгенерированному расширением
# "Get cookies.txt LOCALLY"). Полезно для Render.
# COOKIES_FILE=cookies.txt

# Или само содержимое cookies.txt (текст или его base64) — самый удобный способ
# для Render: вставляется одной строкой в переменную окружения, бот сам запишет
# его в файл при старте. Нужно для YouTube (Render блокирует без cookies).
# # COOKIES_CONTENT=

# Клиент YouTube для yt-dlp (android / android_music / ios / tv / web).
# Помогает, если YouTube просит "подтверди, что ты не бот" даже с cookies.
# # YT_CLIENT=android

# Режим вебхука (для продакшна на Render/Railway)
# На локальной машине бот работает через polling
USE_WEBHOOK=False
WEBHOOK_URL=https://ваш-домен.onrender.com
WEBHOOK_PORT=8080
